{
  "name": "erasemc/aegis-pm",
  "description": "PocketMine-MP bridge for the Aegis anticheat",
  "type": "pocketmine-plugin",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-sockets": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "pocketmine/pocketmine-mp": "~5.44.0"
  },
  "autoload": {
    "psr-4": {
      "aegis\\": "src/"
    }
  },
  "scripts": {
    "lint": "@php scripts/lint.php",
    "test": "@php tests/run.php",
    "analyse": "phpstan analyse --no-progress",
    "build": "@php -d phar.readonly=0 scripts/build.php"
  },
  "config": {
    "sort-packages": true
  }
}
